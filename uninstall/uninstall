#!/bin/bash
# Matter to Loxone - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag.
# Vier Dinge bleiben sonst liegen, und das erste davon ist das ernste:
#
#   1. DER DOCKER-CONTAINER. Er wird mit --restart=unless-stopped
#      angelegt (mt_container_befehl in mt_lib.php). Docker startet ihn
#      damit bei jedem Systemstart wieder - auch Jahre nachdem das Plugin
#      fort ist. Er belegt weiter Port 5580, haelt die Matter-Fabric und
#      taucht in keiner LoxBerry-Uebersicht mehr auf. Ohne diese Datei
#      wird man ihn nur los, wenn man von selbst auf die Docker-
#      Kommandozeile kommt.
#   2. config/plugins/<ordner>.backup.json
#      Die Sicherung der Konfiguration liegt bewusst NEBEN dem
#      Konfigordner, damit sie Update und Neuinstallation uebersteht
#      (mt_paths()['sicherung']). Beim Deinstallieren ist genau das
#      falsch: darin stehen WLAN-Passwort, Thread-Dataset und das
#      Aktionstoken. Das sind Netzzugangsdaten.
#   3. Ein noch laufender Abrufdienst (matter_dienst.py).
#   4. Werte im MQTT-Broker. Seit 0.9.17 gehen Zustaende retained hinaus;
#      bis 0.9.28 blieben sie nach dem Deinstallieren stehen und kamen nach
#      jedem Neustart von Broker oder Gateway wieder am Miniserver an (in
#      WSL gemessen 25.09.2026, Pruefung-Matter2Lox-0.9.29, Fall U1).
#      Schritt "MQTT" unten leert sie - seit dem Verbesserungsbau vom
#      30.09.2026 auch die Themen unter haus/tuer/ (Einstellung tuer_haus).
#
# ZUR PROZESSSUCHE: "pkill -f matter_dienst.py" waere unsauber - das
# Muster traefe auch einen Editor, in dem die Datei offen ist. Verglichen
# wird argumentweise gegen den vollen Pfad.
#
# ZUR FABRIC: <daten>/matter enthaelt die Matter-Fabric samt Zertifikaten.
# Wer sie verliert, muss JEDES Geraet neu anlernen. Dieses Skript loescht
# sie nicht - LoxBerry entfernt den Datenordner ohnehin selbst, und darauf
# wird unten ausdruecklich hingewiesen, damit niemand ueberrascht wird.

PDIR=$3
[ -n "$PDIR" ] || PDIR="matter2lox"
BASE="${5:-$LBHOMEDIR}"
# Dritter Rueckfall: vom eigenen Ablageort AUFWAERTS suchen. Bewusst kein
# fest verdrahteter Systempfad - LoxBerry laesst sich anderswohin
# installieren. Der Installer legt dieses Skript als
# <home>/data/system/uninstall/<ordner> ab und uebergibt die LoxBerry-Wurzel
# als fuenftes Argument (plugininstall.pl:1158 und :1577, am Geraet
# nachgesehen 17.09.2026); dieser Zweig greift nur, wenn beides fehlt.
#
# Wurzel ist, was config/plugins, data/plugins UND config/system/general.json
# traegt (Regeln/06) - dieselbe Regel wie in bin/dienst.sh. Bis 0.9.28 wurden
# hier drei Ebenen hinauf gerechnet und nichts geprueft: in WSL gemessen
# (25.09.2026, Pruefung-Matter2Lox-0.9.29, Fall W4) loeschte das Skript,
# abgelegt unter <fremd>/data/system/uninstall/, in <fremd> ohne general.json
# die Sicherung mit den Netzzugangsdaten und die Matter-Fabric. Ohne Wurzel
# wird jetzt nichts beendet und nichts entfernt.
mt_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            printf '%s\n' "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
# Was der Installer ($5) oder die Umgebung nennt, gilt nur mit config/plugins
# darunter (Bauart Weissware 0.9.29).
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    BASE=$(mt_wurzel_suchen)
fi
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden - nichts beendet, nichts entfernt."
    echo "<WARNING> Liegen bleiben koennen config/plugins/$PDIR.backup.json (WLAN-Passwort, Thread-Dataset,"
    echo "<WARNING> Aktionstoken), die Matter-Fabric data/plugins/$PDIR.matter und der Docker-Container."
    exit 1
fi

PBIN="$BASE/bin/plugins/$PDIR"
PDATA="$BASE/data/plugins/$PDIR"
PCONFIG="$BASE/config/plugins/$PDIR"
BK="$BASE/config/plugins/$PDIR.backup.json"
SKRIPT="$PBIN/matter_dienst.py"

# ---------------------------------------------------------------- Dienst
# Ist die Nummer $1 ein Dienst dieses Plugins? Argumentweise: argv[0] ist
# ein Python, argv[1] ist genau unser Skript. Bis 0.9.25 wurde nur argv[1]
# verglichen; am 18.09.2026 in WSL gemessen, beendete dieses Skript damit
# einen fremden 'tail -f .../matter_dienst.py'. Dieselbe Probe steht in
# bin/dienst.sh und in preupgrade.sh.
mt_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    tr '\0' '\n' 2>/dev/null < "/proc/$1/cmdline" | {
        IFS= read -r a0 || exit 1
        IFS= read -r a1 || exit 1
        case "${a0##*/}" in python|python3|python3.*) ;; *) exit 1 ;; esac
        [ "$a1" = "$2" ]
    }
}
# Dieses Skript laeuft als root, der Dienst gehoert loxberry. Gibt es den
# Benutzer nicht (Pruefstand), gilt der eigene.
DIENST_UID=$(id -u loxberry 2>/dev/null || id -u)
GEFUNDEN=0
for D in /proc/[0-9]*; do
    P=$(basename "$D")
    [ -r "$D/cmdline" ] || continue
    [ "$(stat -c %u "$D" 2>/dev/null)" = "$DIENST_UID" ] || continue
    if mt_ist_dienst "$P" "$SKRIPT"; then
        kill "$P" 2>/dev/null
        for i in 1 2 3 4 5; do
            mt_ist_dienst "$P" "$SKRIPT" || break
            sleep 1
        done
        # Vor dem harten Signal erneut ARGUMENTWEISE pruefen, nicht nur
        # "kill -0": die Nummer kann inzwischen ein anderer Prozess tragen.
        # Bis 0.9.28 stand hier ein blankes "kill -9" - in WSL gemessen
        # (25.09.2026, Pruefung-Matter2Lox-0.9.29, Fall D2) traf es einen
        # Prozess, der nach SIGTERM kein Dienst mehr war.
        if mt_ist_dienst "$P" "$SKRIPT"; then
            kill -9 "$P" 2>/dev/null
            sleep 1
        fi
        GEFUNDEN=1
        # Die WIRKUNG nachsehen, nicht den Rueckgabewert von kill.
        if mt_ist_dienst "$P" "$SKRIPT"; then
            echo "<WARNING> Der Abrufdienst (PID $P) laeuft weiter."
        else
            echo "<OK> Abrufdienst beendet (PID $P)."
        fi
    fi
done
[ "$GEFUNDEN" -eq 0 ] && echo "<INFO> Es lief kein Abrufdienst."
rm -f "$PDATA/soll_laufen" "$PDATA/dienst.pid" 2>/dev/null

# ------------------------------------------------------------------ MQTT
# Zurueckbehaltene Themen der Linie leeren - unter dem eingestellten und
# seit 0.9.30 (M5) unter jedem gemerkten Praefix. NACH dem Anhalten des Dienstes -
# sonst schriebe er die Werte gleich wieder hinein - und vor dem Loeschen der
# Ordner: Konfiguration (Praefix), Geraetenummern, letztes Abbild und bin/
# sind hier noch da; der Installer loescht sie erst nach diesem Skript
# (plugininstall.pl, purge_installation). Welche Themen, wie nachgelesen
# wird und warum hoechstens dreimal: mqtt_leeren() in bin/matter_dienst.py.
#
# Als loxberry, nicht als root: gebraucht wird nur Lesezugriff auf die
# Konfiguration und die general.json. stdin geschlossen, damit su nie auf
# eine Eingabe wartet (Regeln/02).
#
# 'timeout -k 5 60': ohne -k schickt timeout nach 60 s nur SIGTERM - ein
# Programm, das es nicht annimmt, hielte die Deinstallation an, und die
# Sicherung mit den Netzzugangsdaten (Schritt "Sicherung") bliebe liegen.
# Nach 60 s SIGTERM, nach weiteren 5 s SIGKILL, und der Abbruch steht als
# WARNING da, nicht hinter einem '|| true' (Bauart Weissware 0.9.34,
# Schritt 1b; gemessen: Pruefung-Matter2Lox-0.9.29, Fall U4).
# Rueckgabe 0-2 meldet matter_dienst.py selbst (mqtt_leeren()).
MT_RC=0
MT_PY=""
if [ -x "$PBIN/venv/bin/python3" ]; then
    MT_PY="$PBIN/venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    MT_PY=$(command -v python3)
fi
if [ -n "$MT_PY" ] && [ -f "$SKRIPT" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env PYTHONDONTWRITEBYTECODE=1 \
            "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout -k 5 60 "$MT_PY" \
            "$SKRIPT" --mqtt-leeren)" < /dev/null 2>&1 || MT_RC=$?
    else
        env PYTHONDONTWRITEBYTECODE=1 "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout -k 5 60 "$MT_PY" "$SKRIPT" --mqtt-leeren < /dev/null 2>&1 || MT_RC=$?
    fi
    case "$MT_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen wurde nach 60 s abgebrochen - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen reagierte nach 60 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        *) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen endete unerwartet (Rueckgabe $MT_RC) - unter dem Praefix der Linie kann noch etwas im Broker stehen." ;;
    esac
else
    echo "<INFO> Python oder bin/matter_dienst.py fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# ------------------------------------------------------------- Container
# I3 (Durchgang 30.09.2026, Entscheidung 9 sinngemaess): entfernt wird nur
# ein Container, den DIESES Plugin betreibt:
#   - er traegt das Label de.loxberry.plugin.folder=<ordner> (seit 0.9.30
#     beim Anlegen gesetzt, mt_container_befehl() in mt_lib.php), oder
#   - Altbestand ohne Label: nur mit eigener_container=1 UND einem Abbild des
#     Matter-Servers (python-matter-server bzw. matterjs-server).
# Bei eigener_container=0 nie. Bis 0.9.30 entfernte dieses Skript jeden
# Container mit dem eingestellten Namen - ab Werk "matter-server", also auch
# den eigenen Matter-Server eines Anwenders, der im Plugin nur dessen Adresse
# eingetragen hatte (gemessen mit einer Docker-Attrappe, Bericht installer
# I3). Jeder andere wird nicht angefasst; stattdessen steht der Befehl zum
# Abtippen da.
NAME=""
EIGEN=""
if [ -r "$PCONFIG/matter2lox.json" ] && command -v python3 >/dev/null 2>&1; then
    LESEN=$(python3 -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
    n=str(d.get("container_name") or "")
    e=d.get("eigener_container", 1)
    e=1 if (e is True or (not isinstance(e, bool) and e == 1) or str(e).strip().lower() in ("1", "true", "ja", "on")) else 0
    print(n)
    print(e)
except Exception:
    print("")
    print("")' "$PCONFIG/matter2lox.json" 2>/dev/null)
    NAME=$(printf '%s\n' "$LESEN" | sed -n 1p)
    EIGEN=$(printf '%s\n' "$LESEN" | sed -n 2p)
fi
# 0.9.35 (Nr. 4): Vorgabe matter2lox-server, wie in mt_vorgaben().
[ -n "$NAME" ] || NAME="matter2lox-server"

case "$NAME" in
    [A-Za-z0-9]*) : ;;
    *) echo "<WARNING> Containername '$NAME' sieht nicht plausibel aus - er wird nicht angefasst."
       NAME="" ;;
esac

FABRIC="$BASE/data/plugins/$PDIR.matter"

# 0.9.35 (Nr. 10): die Pruefung "ist das unser Container?" steht HIER und
# nicht mehr im Aufruf von bin/container_eigen.sh. Dieses Skript laeuft als
# root, bin/ gehoert loxberry - wer als loxberry Code ausfuehren konnte, kam
# ueber die Deinstallation zu root. Die Regel ist dieselbe wie in
# bin/container_eigen.sh (Aenderungen an BEIDEN Stellen):
#   0 eigen  - Label de.loxberry.plugin.folder=<ordner> (immer, auch bei
#              eigener_container=0), oder Altbestand ohne Label mit
#              eigener_container=1, Abbild des Matter-Servers UND /data aus der
#              Fabric dieses Plugins (0.9.35, Nr. 4: bis 0.9.34 genuegte das
#              Abbild - ein eigener "matter-server" des Anwenders galt als unser)
#   1 fremd, 2 keiner dieses Namens, 3 nicht zu klaeren
mt_container_eigen() {
    N="$1"
    if ! FEHL=$(timeout -k 5 30 docker inspect --type container -- "$N" 2>&1 >/dev/null); then
        case "$FEHL" in
            *"No such container"*|*"no such container"*|*"No such object"*) GRUND="kein Container dieses Namens"; return 2 ;;
        esac
        GRUND="Docker antwortet nicht verwertbar: $(printf '%s' "$FEHL" | head -n 1 | cut -c1-160)"
        return 3
    fi
    L=$(timeout -k 5 30 docker inspect --type container -f '{{index .Config.Labels "de.loxberry.plugin.folder"}}' -- "$N" 2>/dev/null)
    [ "$L" = "<no value>" ] && L=""
    if [ -n "$L" ] && [ "$L" = "$PDIR" ]; then
        GRUND="Label de.loxberry.plugin.folder=$PDIR"; return 0
    fi
    A=$(timeout -k 5 30 docker inspect --type container -f '{{.Config.Image}}' -- "$N" 2>/dev/null)
    Q=$(timeout -k 5 30 docker inspect --type container -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' -- "$N" 2>/dev/null)
    if [ "$EIGEN" = "1" ] && [ -z "$L" ]; then
        case "$A" in
            *python-matter-server*|*matterjs-server*)
                if [ "$Q" = "$FABRIC" ] || [ "$Q" = "$PDATA/matter" ]; then
                    GRUND="Altbestand ohne Label, Abbild $A, /data aus $Q"; return 0
                fi ;;
        esac
    fi
    GRUND="traegt nicht das Label de.loxberry.plugin.folder=$PDIR und ist kein Altbestand dieses Plugins (Label '${L:-keines}', Abbild '${A:-unbekannt}', /data '${Q:-keines}')"
    return 1
}
mt_container_weg() {
    N="$1"
    timeout -k 5 60 docker rm -f -- "$N" >/dev/null 2>&1
    # Die Wirkung nachsehen, nicht dem Rueckgabewert glauben.
    if timeout -k 5 30 docker inspect --type container -- "$N" >/dev/null 2>&1; then
        echo "<WARNING> Container '$N' liess sich nicht entfernen. Von Hand: docker rm -f $N"
    else
        echo "<OK> Docker-Container '$N' angehalten und entfernt ($GRUND)."
    fi
}

if ! command -v docker >/dev/null 2>&1; then
    echo "<INFO> Docker ist nicht installiert - es gibt keinen Container zu entfernen."
else
    if [ -n "$NAME" ]; then
        mt_container_eigen "$NAME"
        ERC=$?
        case "$ERC" in
            0) mt_container_weg "$NAME" ;;
            2) echo "<INFO> Kein Container namens '$NAME' vorhanden." ;;
            1) echo "<INFO> Der Container '$NAME' wird NICHT angefasst: $GRUND."
               echo "<INFO> Gehoert er doch zu diesem Plugin, von Hand: docker rm -f $NAME" ;;
            *) echo "<WARNING> Ob der Container '$NAME' zu diesem Plugin gehoert, liess sich nicht klaeren ($GRUND) - er wird NICHT angefasst. Gehoert er dazu, von Hand: docker rm -f $NAME" ;;
        esac
    fi
    # 0.9.35 (Nr. 15): auch Container mit UNSEREM Label unter einem anderen
    # Namen - etwa nach einer Umbenennung in den Einstellungen. Bis 0.9.34
    # blieben sie mit --restart=unless-stopped fuer immer stehen.
    for N in $(timeout -k 5 30 docker ps -a --filter "label=de.loxberry.plugin.folder=$PDIR" --format '{{.Names}}' 2>/dev/null); do
        [ "$N" = "$NAME" ] && continue
        GRUND="Label de.loxberry.plugin.folder=$PDIR, frueherer Name"
        mt_container_weg "$N"
    done
    echo "<INFO> Das Abbild bleibt liegen - es kann von anderen Containern"
    echo "<INFO> genutzt werden. Zum Aufraeumen: docker image prune"
fi

# ------------------------------------------------------------- Sicherung
# I2 (Durchgang 30.09.2026): mit der Zweitschrift gehen auch ihre Nachbarn -
# die .kaputt, die mt_config() bei einer unlesbaren Zweitschrift anlegt
# (mt_lib.php), und die .alt, die eine Neuinstallation beiseitelegt
# (preinstall.sh, Entscheidung 1). Die Schlusszeile steht erst nach dem
# Nachzaehlen. Bis 0.9.30 blieb die .kaputt mit Token und WLAN-Passwort
# liegen, waehrend die Meldung "sind damit fort" sagte (gemessen, Bericht
# installer I2, Fall X1).
GEFUNDEN_BK=0
REST=""
for S in "$BK" "$BK.kaputt" "$BK.alt" "$BK.kaputt.alt"; do
    if [ -e "$S" ] || [ -L "$S" ]; then
        GEFUNDEN_BK=1
        rm -f "$S" 2>/dev/null
        if [ -e "$S" ] || [ -L "$S" ]; then
            REST="$REST $S"
        else
            echo "<OK> Entfernt: $(basename "$S")"
        fi
    fi
done
if [ -n "$REST" ]; then
    echo "<WARNING> Liegen geblieben (darin koennen WLAN-Passwort, Thread-Dataset und Aktionstoken stehen):$REST - bitte von Hand entfernen."
elif [ "$GEFUNDEN_BK" -eq 1 ]; then
    echo "<INFO> Nachgezaehlt: keine Zweitschrift der Konfiguration liegt mehr neben dem Plugin-Ordner - WLAN-Passwort, Thread-Dataset und Aktionstoken sind damit fort."
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi

# ----------------------------------------------------------------- Reste
# Fabric und Geraetenummern liegen NEBEN dem Plugin-Ordner (seit 0.9.17,
# damit sie ein Update ueberstehen). Genau deshalb raeumt der Installer sie
# NICHT mit ab - das muss dieses Skript tun, sonst bleiben sie als Waisen
# liegen. Bei einer Deinstallation ist das Loeschen richtig; gesagt wird es
# ausdruecklich, und zwar VORHER.
NUMMERN="$BASE/data/plugins/$PDIR.nummern.json"
LIEFMARKE="$BASE/data/plugins/$PDIR.lief"
# Die Marke "Aktualisierung laeuft" aus preupgrade.sh. Bleibt sie liegen,
# wuerde eine Neuinstallation binnen einer Stunde nicht starten.
UPGRADEMARKE="$BASE/data/plugins/$PDIR.upgrade_laeuft"

echo "<WARNING> Die Matter-Fabric wird jetzt entfernt ($FABRIC), sofern kein Container sie mehr einbindet."
echo "<INFO> Jedes Geraet, das ueber dieses Plugin angelernt wurde, muesste"
echo "<INFO> danach neu angelernt werden. Deshalb bleibt seit 0.9.35 eine letzte"
echo "<INFO> Sicherung liegen (siehe unten); ein Update ueberlebt die Fabric ohnehin."
# 0.9.35 (Nr. 7): nicht loeschen, solange ein Container sie noch einbindet.
# Bis 0.9.34 hing das rm -rf nicht am Ergebnis des Container-Schritts: blieb
# der Container stehen (fremd erkannt, Docker antwortete nicht, rm scheiterte),
# verlor er beim naechsten Neustart sein /data und mit ihm jedes Geraet.
# Ist Docker nicht zu fragen, wird ebenfalls nichts geloescht.
FABRIC_BELEGT=""
FABRIC_UNKLAR=0
if [ -d "$FABRIC" ] && command -v docker >/dev/null 2>&1; then
    if IDS=$(timeout -k 5 30 docker ps -aq 2>/dev/null); then
        for ID in $IDS; do
            QUELLEN=$(timeout -k 5 30 docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' -- "$ID" 2>/dev/null)
            if printf '%s\n' "$QUELLEN" | grep -qxF "$FABRIC"; then
                FABRIC_BELEGT="$FABRIC_BELEGT $(timeout -k 5 30 docker inspect -f '{{.Name}}' -- "$ID" 2>/dev/null | sed 's#^/##')"
            fi
        done
    else
        FABRIC_UNKLAR=1
    fi
fi
if [ ! -d "$FABRIC" ]; then
    echo "<INFO> Keine Fabric am neuen Ort vorhanden."
elif [ -n "$FABRIC_BELEGT" ]; then
    echo "<WARNING> Die Matter-Fabric bleibt liegen ($FABRIC): der Container$FABRIC_BELEGT bindet sie noch ein."
    echo "<WARNING> Ohne sie verloere er beim naechsten Neustart jedes Geraet. Wird er nicht mehr"
    echo "<WARNING> gebraucht: docker rm -f <name> und danach rm -rf '$FABRIC'"
elif [ "$FABRIC_UNKLAR" = 1 ]; then
    echo "<WARNING> Die Matter-Fabric bleibt liegen ($FABRIC): Docker antwortet nicht, ob ein"
    echo "<WARNING> Container sie noch einbindet. Von Hand pruefen und danach rm -rf '$FABRIC'"
else
    # 0.9.35 (E7): vor dem Loeschen eine letzte Sicherung. Wer zur Reparatur
    # deinstalliert und neu installiert, spielt sie im Reiter Einstellungen
    # (Fuer Fortgeschrittene, Fabric wiederherstellen) zurueck und muss kein
    # Geraet neu anlernen. Sie traegt die Schluessel der Fabric: 0600, dem
    # Benutzer loxberry, und die Meldung sagt, wie man sie loswird.
    SICHER_ORDNER="$BASE/data/plugins/$PDIR.fabric_sicherungen"
    LETZTE="$SICHER_ORDNER/deinstallation-$(date +%Y%m%d-%H%M%S).tar.gz"
    GESICHERT=0
    if [ -n "$(ls -A "$FABRIC" 2>/dev/null)" ] && mkdir -p "$SICHER_ORDNER" 2>/dev/null \
       && (umask 077; tar -czf "$LETZTE" -C "$FABRIC" . 2>/dev/null); then
        chmod 700 "$SICHER_ORDNER" 2>/dev/null
        chmod 600 "$LETZTE" 2>/dev/null
        chown -R loxberry:loxberry "$SICHER_ORDNER" 2>/dev/null
        GESICHERT=1
    fi
    if [ "$GESICHERT" = 1 ] || [ -z "$(ls -A "$FABRIC" 2>/dev/null)" ]; then
        rm -rf "$FABRIC" && echo "<OK> Matter-Fabric entfernt." \
            || echo "<WARNING> Die Fabric liess sich nicht entfernen: $FABRIC"
        if [ "$GESICHERT" = 1 ]; then
            echo "<INFO> Letzte Sicherung der Fabric: $LETZTE"
            echo "<INFO> Sie enthaelt die Schluessel der Matter-Fabric. Wird sie nicht mehr gebraucht:"
            echo "<INFO>   rm -rf '$SICHER_ORDNER'"
        fi
    else
        echo "<WARNING> Die Fabric liess sich nicht sichern - sie bleibt deshalb liegen ($FABRIC)."
        echo "<WARNING> Wird sie nicht mehr gebraucht: rm -rf '$FABRIC'"
    fi
fi
if [ -f "$NUMMERN" ]; then
    rm -f "$NUMMERN" && echo "<OK> Geraetenummern entfernt: $PDIR.nummern.json"
fi
rm -f "$LIEFMARKE" "$UPGRADEMARKE" 2>/dev/null
# M5 (Durchgang 30.09.2026): die Liste der je benutzten MQTT-Praefixe. Der
# Schritt "MQTT" oben hat unter jedem davon abgeraeumt; danach geht sie.
rm -f "$BASE/config/plugins/$PDIR.mqtt_praefixe.json" 2>/dev/null
# Tuer-1 (Verbesserungsbau 30.09.2026): die Liste der je unter haus/tuer/
# gesendeten Themen. Der Schritt "MQTT" oben hat sie abgeraeumt (--mqtt-leeren).
rm -f "$BASE/config/plugins/$PDIR.haus_themen.json" 2>/dev/null
# 0.9.35 (D2): die festen Namen unter haus/tuer/.
rm -f "$BASE/config/plugins/$PDIR.haus_namen.json" 2>/dev/null
# 0.9.35 (E7): beim Zurueckspielen einer Sicherung legt die Oberflaeche die
# bisherige Fabric als <ordner>.matter.vorher-<zeit> beiseite. Sie traegt
# Schluessel, wird nach der Deinstallation nie mehr gebraucht und geht - die
# letzte Sicherung oben bleibt.
for V in "$BASE/data/plugins/$PDIR.matter.vorher-"*; do
    [ -e "$V" ] || continue
    rm -rf "$V" && echo "<OK> Beiseitegelegte Fabric entfernt: $(basename "$V")" \
        || echo "<WARNING> Liess sich nicht entfernen: $V"
done
# Der alte Ort bis 0.9.16 - liegt im Datenordner und geht mit ihm.
[ -d "$PDATA/matter" ] && echo "<INFO> Ein alter Fabric-Ordner ($PDATA/matter) geht mit dem Datenordner."
exit 0
