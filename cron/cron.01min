#!/bin/sh
# Matter to Loxone - Waechter, minuetlich.
# Die Platzhalter in den Befehlszeilen unten werden bei der Installation durch
# den bin- bzw. log-Pfad des Plugins ersetzt. Sie stehen bewusst nicht im
# Kommentar: die Ersetzung trifft jede Fundstelle, und der Satz laese sich
# danach nicht mehr verstehen.
#
# I6 (Durchgang 30.09.2026, Bauform Abfahrts-Assistent 1.6.10): die
# FEHLERausgabe geht nach cron.err neben dem Protokoll, nicht mehr ins Leere.
# Bis 0.9.30 endete die Zeile auf ">/dev/null 2>&1" - "kein
# LoxBerry-Wurzelverzeichnis" oder ein fehlendes Ausfuehrungsrecht sah
# niemand (Regeln/03, "Der Cron-Eintrag verschluckt seine Fehlerausgabe
# nicht"). Erst den Ordner anlegen und cron.err anfassen: log/plugins liegt
# auf der RAM-Platte und kann fehlen; scheitert die Umlenkung, fuehrt die
# Schale den Befehl gar nicht aus. Ein Anhaengen ohne Inhalt frischt die
# Aenderungszeit nicht auf, und die Protokollwartung raeumt eine alte Datei
# weg (Regeln/06). Die regulaere Ausgabe bleibt still.
#
# Waechter der Befehlsbruecke (seit 0.9.44, Gruppe 8; Entwurf 3.9, E12) - als ERSTE Anweisung, vor dem
# Waechter des Dienstes und dessen Startsperre: startet die Bruecke nach Boot und Update spaetestens nach einer
# Minute, wenn "Befehle ueber MQTT annehmen" gesetzt ist, und haelt sie sonst an (befehlsbruecke.php --waechter:
# misst zustand.json, nie waehrend einer Aktualisierung, hoechstens alle 600 s ein Neustart). Kein Start in den
# Hakenskripten. Ausgabe nach /dev/null: die Bruecke protokolliert selbst.
BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>&1
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 0.9.46 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.45 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
/bin/bash "REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$ERR"
