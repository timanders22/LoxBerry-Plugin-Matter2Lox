 "ereignisthemen": {
  "_hinweis": [
   "Themen, die NICHT aus einem Attribut stammen, sondern aus einem Ereignis.",
   "Ein Tastendruck kommt bei Matter ausschliesslich als Ereignis (node_event);",
   "es gibt kein Attribut, das man abfragen koennte. Der Dienst merkt sich das",
   "letzte Ereignis je Endpunkt und veroeffentlicht es unter diesen Themen.",
   "",
   "taste_zaehler ist der Grund, warum das in Loxone ueberhaupt brauchbar ist:",
   "wer zweimal dieselbe Taste drueckt, erzeugt zweimal denselben Ereigniscode -",
   "ein Eingang, der auf Wertaenderung reagiert, saehe den zweiten Druck nicht.",
   "Der Zaehler aendert sich immer."
  ],
  "themen": {
   "taste": {
    "thema": "taste",
    "typ": "zahl",
    "text": "MT_ATTR.TASTE",
    "min": 0,
    "max": 6,
    "_quelle": "Ereigniscode aus switch-cluster.xml: 0 eingerastet, 1 gedrueckt, 2 lang gedrueckt, 3 kurz losgelassen, 4 lang losgelassen, 5 Mehrfachdruck laeuft, 6 Mehrfachdruck fertig"
   },
   "taste_zaehler": {
